# Gateway-only credentials. Never copy the LOFT database/JWT/S3 env here.
# Generate a token with npm run ai:lightsail:setup; copy that same token to the backend.
OPENCLAW_DOMAIN=""
OPENCLAW_GATEWAY_TOKEN=""
OPENROUTER_API_KEY=""
OPENROUTER_STT_MODEL="openai/gpt-4o-mini-transcribe"
OPENROUTER_TTS_MODEL="google/gemini-3.1-flash-tts-preview"
OPENROUTER_TTS_VOICE="Kore"
