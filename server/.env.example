DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Test & Development Database Isolation
# Integration tests fail closed if TEST_DATABASE_URL is not configured.
# Must point to an isolated test database (e.g. Neon branch) and must not match DATABASE_URL.
TEST_DATABASE_URL=""

# Explicit opt-in required to execute development seed fixtures (`npm run prisma:seed`).
# Fails closed if missing, empty, or false. Automatically rejected when NODE_ENV=production.
ALLOW_DEV_SEED=""

JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Google Sign-In (OAuth client ID from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""

# Optional: outgoing email over SMTP, used for workspace invites. Any provider
# with SMTP works. For Gmail, turn on 2-Step Verification, create an app password
# (Google Account > Security > App passwords), and use smtp.gmail.com, port 465,
# your Gmail address as SMTP_USER and the app password as SMTP_PASS.
# If omitted, invites are still created: people with a LOFT account get an
# in-app notification, and admins can copy each invite link to send it themselves.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Shown as the sender. Defaults to "LOFT <SMTP_USER>"; providers like Resend
# need an address on a domain you've verified with them.
MAIL_FROM=""

# Optional at server startup: private AWS S3 object storage.
# Used for workspace file storage, task attachments, and chat file uploads.
# If omitted or left blank, the server starts normally and file-upload/download endpoints return HTTP 503.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Native AWS S3 normally leaves AWS_ENDPOINT_URL_S3 blank. It is only an
# override for a local/S3-compatible endpoint.
AWS_ENDPOINT_URL_S3=""
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET=""
