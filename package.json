{
  "name": "loft",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:seed": "npm run prisma:seed -w server"
  },
  "devDependencies": {
    "@neon/config": "^1.3.0",
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@neon/functions": "^0.9.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "yjs": "^13.6.32"
  }
}
