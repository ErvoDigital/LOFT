# Origin of the authenticated SyncTayo app. Login links append /login;
# Get Started and free-trial links append /register. This is the default origin.
# The retired app.loft-client.site origin is replaced with this default.
VITE_LOFT_APP_URL=https://client.synctayo.online

# For local development with the client running on port 5173:
# VITE_LOFT_APP_URL=http://localhost:5173
